{
  "name": "ioslib",
  "version": "6.0.0",
  "description": "iOS Utility Library",
  "keywords": [
    "apple",
    "ios",
    "ipad",
    "iphone",
    "watchos",
    "xcode"
  ],
  "homepage": "https://github.com/tidev/ioslib",
  "bugs": "https://github.com/tidev/ioslib/issues",
  "license": "Apache-2.0",
  "author": "TiDev, Inc. <npm@tidev.io>",
  "repository": "https://github.com/tidev/ioslib",
  "files": [
    "dist",
    "scripts"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsdown -c tsdown.config.ts",
    "check": "pnpm type-check && pnpm lint && pnpm fmt:check",
    "coverage": "vitest --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "always-tail": "0.2.0",
    "bplist-parser": "0.3.2",
    "node-ios-device": "8.0.0",
    "snooplogg": "9.0.0",
    "which": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "lefthook": "2.1.9",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "rimraf": "6.1.3",
    "tsdown": "0.22.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "node-ios-device@8.0.0": true
  }
}
